---
import "../styles/global.css";
import Navigation from "../components/Navigation.astro";

//export const MainLayout = true;
const {
	title,
	description,
	showNavigation = true,
	navigationItems,
} = Astro.props;

// Default navigation items
const defaultNavigationItems = [
	{ label: "Homepage", href: "/" },
];

//if the component does not have navigation items, use the default
const navItems = navigationItems || defaultNavigationItems;

const base = import.meta.env.BASE_URL || "/";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="images/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="bg-blue-950 min-h-screen">
		{showNavigation && <Navigation items={navItems} />}
		<slot />
	</body>
</html>
