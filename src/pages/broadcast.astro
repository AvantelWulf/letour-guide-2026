---
//To do:
//	- Bring this page up to the quality of the listening page.
//	- Make the "Answer Question" button a dotted line if there are no incoming questions.

//main imports
import Layout from "../layouts/listenLayout.astro";
import "../styles/global.css";
import defineConfig from "astro.config.mjs";
// Component Imports
import { Button } from "@/components/ui/button";
import { navigate } from "astro:transitions/client";
import BroadcastSoundbyte from "@/components/sound/BroadcastSoundbyte";
import BroadcastMic from "@/components/sound/BroadcastMic";
//variables
const baseURL = import.meta.env.BASE_URL;

// src/pages/protected-page.astro

export const prerender = false; // Required for server-side checks

const CORRECT_PASSCODE = "RGApproved"; // Define your passcode
let isAuthenticated = false;
let errorMessage = "";

// 1. Handle form submission (When user enters the passcode)
if (Astro.request.method === "POST") {
  console.info("Broadcast POST origin check", {
    requestOrigin: new URL(Astro.request.url).origin,
    originHeader: Astro.request.headers.get("origin"),
    forwardedHost: Astro.request.headers.get("x-forwarded-host"),
    forwardedProto: Astro.request.headers.get("x-forwarded-proto"),
  });

  // Existing form handling continues here
if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    const passcode = data.get("passcode");

    if (passcode === CORRECT_PASSCODE) {
      // Set a session cookie that expires when the browser closes
      Astro.cookies.set("page_access_token", "granted", { path: Astro.url.pathname });
      isAuthenticated = true;
    } else {
      errorMessage = "Incorrect passcode. Please try again.";
    }
  } catch (error) {
    if (error instanceof Error) {
      console.error(error.message);
    }
  }
}

// 2. Check if user already has a valid session cookie
if (!isAuthenticated && Astro.cookies.has("page_access_token")) {
  isAuthenticated = true;
}
---

<html>
  <head>
    <title>Protected Page</title>
  </head>
  <body style="font-family: sans-serif; max-width: 500px; margin: 50px auto; padding: 20px;">

    {isAuthenticated ? (
      <!-- SUCCESS: Render the actual page content -->
		<Layout title="LeTour Broadcast" description="LeTour Broadcast">
			<!-- <div class="grid place-items-center h-screen content-center"> -->
			<div class="container text-center mx-auto px-4">
				<a href={baseURL} class="underline">
					<Button variant="letu" className="mt-3 mb-3 text-[28px] font-bold w-full max-w-[500px] h-14 px-6 py-2">Go Home</Button>
				</a>
				
				<div class="pb-6 relative flex justify-center"> <!-- object-cover makes the image dynamically crop -->
					<img src=`images/LeTour Guide QR Code (Yellow).png` 
						class="h-[300px] object-cover" 
						alt="Background" 
					/>
				</div>

				<!-- Broadcast button: -->
				<div class="mb-4 border-yellow-400 border-10">
					<BroadcastMic client:only="react" />
				</div>
				
				<!-- Sound effect button: -->
				<!-- <BroadcastSoundbyte client:only="react"/> -->

				<!-- The answer question button: -->
				<div class="flex flex-col items-center space-y-4">
					<Button variant="letu" className="mt-[1vw] text-[28px] font-bold w-r40 h-40 bg-yellow-700 rounded-full px-6 py-2">No Incoming<br>Questions</Button>
				</div>
			</div>
</Layout>
    ) : (
      <!-- PROMPT: Render the passcode entry form -->
      <div>
        <h1>Enter Passcode</h1>
        <p>You must provide the correct passcode to view this page.</p>
        
        <form method="POST">
          <input 
            type="password" 
            name="passcode" 
            placeholder="Enter passcode..." 
            required 
            style="padding: 8px; width: 200px; margin-right: 100%; margin-bottom: 10px;"
          />
          <button type="submit" style="padding: 8px 16px; cursor: pointer;">
            Access Page
          </button>
        </form>

        {errorMessage && <p style="color: red; margin-top: 10px;">{errorMessage}</p>}
      </div>
    )}

  </body>
</html>



