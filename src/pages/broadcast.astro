---
//Main Imports
import { env } from "node:process";
import "../styles/global.css";
import defineConfig from "astro.config.mjs";
//Component Imports
import Layout from "../layouts/listenLayout.astro";
import { Button } from "@/components/ui/button";
import { navigate } from "astro:transitions/client";
import BroadcastSoundbyte from "@/components/sound/BroadcastSoundbyte";
import BroadcastMic from "@/components/sound/BroadcastMic";
import {
	isBroadcastSessionValid,
	BROADCAST_SESSION_COOKIE,
	BROADCAST_SESSION_MAX_AGE_SECONDS,
} from "@/lib/broadcastAuth";

const baseURL = import.meta.env.BASE_URL;
const sessionSecret = env.BROADCAST_SESSION_SECRET;

if (!sessionSecret) {
	throw new Error("BROADCAST_SESSION_SECRET must be configured on the server.");
}

const sessionToken = Astro.cookies.get(BROADCAST_SESSION_COOKIE)?.value;
const isAuthenticated = isBroadcastSessionValid(sessionToken, sessionSecret);
---

<Layout title="LeTour Broadcast" description="LeTour Broadcast">
	{isAuthenticated ? (
		<div>
			<script define:vars={{ maxAgeMs: BROADCAST_SESSION_MAX_AGE_SECONDS * 1000 }}>
				setTimeout(() => window.location.reload(), maxAgeMs);
			</script>
			<div class="container text-center mx-auto px-4">
				<a href={baseURL} class="underline">
					<Button variant="letu" className="mt-3 mb-3 text-[28px] font-bold w-full max-w-[500px] h-14 px-6 py-2">Go Home</Button>
				</a>

				<div class="pb-6 relative flex justify-center">
					<img
						src="images/LeTour Guide QR Code (Yellow).png"
						class="h-[300px] object-cover"
						alt="LeTour Guide QR Code"
					/>
				</div>

				<div class="mb-4 border-yellow-400 border-10">
					<BroadcastMic client:only="react" />
				</div>

				<div class="flex flex-col items-center space-y-4">
					<Button variant="letu" className="mt-[1vw] text-[28px] font-bold w-r40 h-40 bg-yellow-700 rounded-full px-6 py-2">
						No Incoming<br />Questions
					</Button>
				</div>
			</div>
		</div>
	) : (
		<div
			id="auth-prompt"
			data-auth-endpoint={`${baseURL}api/broadcast-auth`}
			class="container mx-auto max-w-lg px-4 py-12 text-center"
		>
			<h1 class="mb-4 text-3xl font-bold text-yellow">Enter Passcode</h1>
			<p class="mb-6 text-yellow">You must provide the correct passcode to view the broadcast page.</p>

			<form id="passcode-form">
				<input
					type="password"
					id="passcode-input"
					placeholder="Enter passcode..."
					autocomplete="current-password"
					required
					class="mb-4 block w-full rounded px-3 py-2 text-yellow"
				/>
				<button id="submit-btn" type="submit" class="rounded bg-yellow-500 px-4 py-2 font-bold text-black">
					Access Page
				</button>
				<p id="error-msg" role="alert" class="mt-4 hidden text-red-400"></p>
			</form>
		</div>
	)}

	<script>
		const prompt = document.getElementById("auth-prompt");
		const form = document.getElementById("passcode-form");
		const input = document.getElementById("passcode-input");
		const submitButton = document.getElementById("submit-btn");
		const errorMessage = document.getElementById("error-msg");

		if (
			prompt instanceof HTMLElement &&
			form instanceof HTMLFormElement &&
			input instanceof HTMLInputElement &&
			submitButton instanceof HTMLButtonElement &&
			errorMessage instanceof HTMLElement
		) {
			form.addEventListener("submit", async (event) => {
				event.preventDefault();
				errorMessage.textContent = "";
				errorMessage.classList.add("hidden");
				submitButton.disabled = true;

				try {
					const response = await fetch(prompt.dataset.authEndpoint ?? "", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ code: input.value }),
						credentials: "same-origin",
					});
					const result: { success?: boolean } = await response.json();

					if (response.ok && result.success) {
						window.location.reload();
						return;
					}

					errorMessage.textContent =
						response.status === 401
							? "Incorrect passcode. Please try again."
							: "Unable to verify the passcode. Please try again.";
					errorMessage.classList.remove("hidden");
				} catch (error) {
					console.error("Broadcast passcode verification failed:", error);
					errorMessage.textContent = "Unable to verify the passcode. Please try again.";
					errorMessage.classList.remove("hidden");
				} finally {
					submitButton.disabled = false;
				}
			});
		}
	</script>
</Layout>
