---

<Layout title="LeTour Listen" description="Listen to audio content">
	<div class="container mx-auto px-4">
		<!-- mx-auto centers the element with its parent -->
		<div>
			<!-- class="mt-2 mx-auto flex justify-center font-bold border-yellow-400
		border-10 w-full h-[16vw]
		md:border-10 md:w-[70vw] md:h-[16vw]"
		> -->
			<ListenAudio client:only="react" />
		</div>

		<!-- There used to be a temporary "number of connected users" here. 
		I don't want to delete this div because it would ruin the spacing. : -->
		<div class="text-center pt-4">
			<h1 class="mt-1 mb-12">
				
			</h1>
		</div>

		<div class="pb-6 relative flex justify-center">
			<!-- object-cover makes the image dynamically crop -->
			<img
				src={`images/LeTour Guide QR Code (Yellow).png`}
				class="w-full max-w-[300px] h-[300px] object-cover"
