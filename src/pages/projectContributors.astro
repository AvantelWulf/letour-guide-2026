---
import "../styles/global.css";
import Layout from "../layouts/mainLayout.astro";
import defineConfig from "astro.config.mjs"
// Component Imports
import { Button } from "@/components/ui/button";
import { navigate } from "astro:transitions/client";

const {
	title,
	description,
	showNavigation = true,
	navigationItems,
} = Astro.props;
const base = import.meta.env.BASE_URL || "/";

// Default navigation items
const defaultNavigationItems = [
	{ label: "Homepage", href: "/" },
	{
		label: "Letu",
		href: "https://letu.edu",
		external: true,
	},
];

//if the component does not have navigation items, use the default
const navItems = navigationItems || defaultNavigationItems;
---
<Layout title="LeTour Contributers" desciption="All Project Contributers for this application">
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LeTour Guide Project Contributors</title>
</head>
<body>
    <h1 class="text-center text-3xl font-bold text-gray-200">LeTour Group Project Contributors</h1>
    <p class="text-center text-3xl font-bold text-gray-200">Fall 2025 Contributors: <a href="https://www.linkedin.com/in/jaredtcrow/">Jared Crow</a>, <a href="https://www.linkedin.com/in/rutledgedixon/">Rutledge Dixon</a>, and <a href="https://charlesg.appwrite.network/">Charles Gitogo</a></p>
	<p class="text-center text-3xl font-bold text-gray-200">Fall 2026 Contributors: <a href="https://www.linkedin.com/in/mason-lassmann/">Mason Lassmann</a> and <a href="https://github.com/AvantelWulf">Daniel Turczynski</a></p>
	<p class="text-center text-3xl font-bold text-gray-200">Factulty Sponsor: <a href="https://www.letu.edu/academics/engineering/fac-bio-tixier.html">Professor John Tixier</a></p>
</body>
</html>
</Layout>